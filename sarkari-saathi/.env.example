# Get your free-tier API key from https://cloud.cerebras.ai/platform/.../keys
CEREBRAS_API_KEY=csk-your-key-here

# Get your bot token from @BotFather on Telegram (send it /newbot)
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-here

# Get a free key from https://tavily.com — used by the AI assistant to search
# official gov.in websites when the local scheme dataset doesn't cover a query.
# Optional: the assistant degrades gracefully (no web search) if unset.
TAVILY_API_KEY=tvly-your-key-here

# Used to send login OTPs via email, over Brevo's HTTPS API (not raw SMTP —
# Render's free tier blocks outbound SMTP ports entirely). Sign up free at
# https://www.brevo.com, verify a sender email under Senders & IPs, then
# grab an API key under SMTP & API > API Keys.
BREVO_API_KEY=xkeysib-your-key-here
EMAIL_FROM_ADDRESS=your-verified-sender@example.com

# Firebase service account JSON (the whole file's contents, as one line),
# used for Firestore (push tokens / synced profiles / notification history /
# session tokens) and required for Android push (FCM V1). Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Shared secret checked on POST /notifications/run-check so only the
# scheduled GitHub Actions workflow (not the public internet) can trigger a
# notification run. Any random string — generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=your-random-secret-here
